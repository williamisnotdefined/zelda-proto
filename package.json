{
  "name": "legends-of-gelehk",
  "private": true,
  "workspaces": ["client"],
  "scripts": {
    "dev:client": "VITE_SERVER_PORT=3003 VITE_DEV_PORT=5174 npm run dev --workspace=client -- --port 5174 --strictPort",
    "dev:server": "PORT=3003 go -C server run ./cmd/server",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm run build --workspace=client",
    "build:server": "go -C server build -o ./bin/server ./cmd/server",
    "build": "npm run build:server && npm run build:client",
    "start:server": "NODE_ENV=production PORT=3001 TRUST_PROXY=1 WS_ALLOWED_ORIGINS=https://wilho.com.br ./server/bin/server",
    "start": "npm run start:server",
    "test:server": "go -C server test ./...",
    "bench:server": "go -C server test ./internal/application/world ./internal/interfaces/wsapi ./internal/infrastructure/transport/ws -run '^$' -bench 'Benchmark(World(Tick|Snapshot)Stress|Broadcast(Stress|DeltaSteadyState|DeltaWithMovement)|WebSocketBroadcastStress)' -benchtime=1x -benchmem",
    "test:e2e": "playwright test",
    "test": "npm run test:server && npm run test --workspace=client",
    "lint": "eslint client/src --ext .ts,.tsx",
    "lint:fix": "eslint client/src --ext .ts,.tsx --fix",
    "format": "prettier --write \"client/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"client/src/**/*.{ts,tsx}\"",
    "live:start": "npm run build && concurrently \"npm run start\" \"cloudflared tunnel run wilho\""
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.5.3",
    "vitest": "^3.2.4"
  }
}
