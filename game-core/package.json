{
  "name": "@gelehka/game-core",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./movement": {
      "types": "./src/movement.ts",
      "import": "./dist/movement.js",
      "default": "./dist/movement.js"
    },
    "./prediction": {
      "types": "./src/prediction.ts",
      "import": "./dist/prediction.js",
      "default": "./dist/prediction.js"
    },
    "./network": {
      "types": "./src/network.ts",
      "import": "./dist/network.js",
      "default": "./dist/network.js"
    },
    "./snapshot": {
      "types": "./src/snapshot.ts",
      "import": "./dist/snapshot.js",
      "default": "./dist/snapshot.js"
    },
    "./input": {
      "types": "./src/input.ts",
      "import": "./dist/input.js",
      "default": "./dist/input.js"
    },
    "./interpolation": {
      "types": "./src/interpolation.ts",
      "import": "./dist/interpolation.js",
      "default": "./dist/interpolation.js"
    },
    "./player": {
      "types": "./src/player.ts",
      "import": "./dist/player.js",
      "default": "./dist/player.js"
    }
  },
  "dependencies": {
    "@gelehka/shared": "*"
  }
}
